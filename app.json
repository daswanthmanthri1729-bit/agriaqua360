{
  "expo": {
    "name": "AgriAqua 360",
    "slug": "agriaqua360",
    "scheme": "agriaqua360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2FBF5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agriaqua360.app"
    },
    "android": {
      "package": "com.agriaqua360.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E4B2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0E5A38"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AgriAqua 360 uses the camera to photograph crops, fish and animals for AI health checks.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriAqua 360 lets you attach photos of your crops, ponds and animals.",
          "cameraPermission": "AgriAqua 360 uses the camera to photograph crops, fish and animals for AI health checks."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AgriAqua 360 records your voice so you can ask farming questions by speaking."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriAqua 360 uses your location for local weather and to save farm locations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#176B45",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d1df0870-16f1-4754-a167-978515dc73c5"
      }
    },
    "owner": "daswanth-m"
  }
}
